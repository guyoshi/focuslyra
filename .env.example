# Focuslyra works without paid AI by default.
ALLOW_PAID_AI=false

# Deployment seam. Personal is the current local-first mode.
# Future hosted/authenticated deployments can switch mode and inject a real user id.
FOCUSLYRA_MODE=personal
FOCUSLYRA_USER_ID=local-owner

# Optional storage roots. Leave empty/default for the normal local installation.
# FOCUSLYRA_DATA_ROOT=C:\focuslyra-data\data
# FOCUSLYRA_PRIVATE_ROOT=C:\focuslyra-data\private
# FOCUSLYRA_MEDIA_ROOT=C:\focuslyra-data\media

# Optional text providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional premium providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local model server
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Free local speech-to-text (installed by configure_free_audio.bat)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Calendar fallback timezone (Google account timezone overrides this after connection)
FOCUSLYRA_TIMEZONE=Europe/Lisbon

# Server
FOCUSLYRA_HOST=127.0.0.1
FOCUSLYRA_PORT=8765
